# Copy this file to .env and adjust values for local development.
# .env is in .gitignore -- never commit real secrets here.
#
# Precedence (highest wins): real OS/container environment variables
# > values in this .env file > the defaults in config.py.
# In Docker/Kubernetes, env vars are injected at container runtime and
# will always override whatever is baked into a .env file in the image.

CRYPTOPULSE_TICKER=BTC-USD
CRYPTOPULSE_START_DATE=2019-01-01
CRYPTOPULSE_DB_PATH=cryptopulse.db
CRYPTOPULSE_SHORT_WINDOW=10
CRYPTOPULSE_LONG_WINDOW=30
